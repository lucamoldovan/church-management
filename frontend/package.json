{
  "name": "church-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate": "wrangler d1 migrations apply CHURCH_DB",
    "db:local": "wrangler d1 execute CHURCH_DB --local --file=./migrations/0001_cloudflare_native.sql",
    "db:remote": "wrangler d1 execute CHURCH_DB --remote --file=./migrations/0001_cloudflare_native.sql",
    "start": "next dev -H 0.0.0.0 -p 3000",
    "lint": "eslint"
  },
  "dependencies": {
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.21.0",
    "next": "16.3.6",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "shadcn": "^4.11.0",
    "stripe": "^17.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.141.0",
    "@cloudflare/workers-types": "^4.20260927.0"
  }
}
