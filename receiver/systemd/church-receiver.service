[Unit]
Description=Veyra fullscreen NDI receiver
Documentation=https://github.com/lucamoldovan/church-management/blob/kasapini-dashboard-audit/docs/independent-startup.md
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=SDL_VIDEODRIVER=x11
ExecStart=/usr/local/bin/veyra --config /etc/veyra/config.json
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=15

# Started by the XFCE session helper after DISPLAY/XAUTHORITY are imported.
