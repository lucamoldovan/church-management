# ============================================================
# Casa Painii - Church Management Platform
# Copy this file to frontend/.env.local and fill in the values.
# ============================================================

# -- Supabase (required) ------------------------------------
# Public keys - safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key - SERVER-SIDE ONLY, never expose to the browser
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# -- Stripe (required for payments) -------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# -- Google Calendar (optional) -----------------------------
# Create OAuth 2.0 credentials in Google Cloud Console.
# Authorized redirect URI: https://your-domain/api/oauth/calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary

# -- Facebook Page (optional) --------------------------------
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# -- YouTube Live auto-detection (optional) -----------------
# Enable YouTube Data API v3 in Google Cloud and create an API key.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# -- Planning Center Services (optional) --------------------
# Create a Personal Access Token for the church's Planning Center account.
PLANNING_CENTER_TOKEN=

# -- Misc ---------------------------------------------------
EVENT_TIMEZONE=Europe/Bucharest
