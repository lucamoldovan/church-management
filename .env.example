# Local API
CHURCH_HOST=127.0.0.1
CHURCH_PORT=8787
# For LAN access, configure all TLS files before setting CHURCH_HOST=0.0.0.0.
CHURCH_TLS_CERT_PATH=
CHURCH_TLS_KEY_PATH=
# Used by the deployment installer for certificate validation/health checks.
# These are installer settings; the API process safely ignores them.
CHURCH_TLS_CA_CERT_PATH=
CHURCH_TLS_EXPECTED_HOST=192.168.0.67
CHURCH_DASHBOARD_DIRECTORY=../dashboard/dist

# Optional Vite development server overrides (defaults to 127.0.0.1:5173)
# CHURCH_DASHBOARD_HOST=127.0.0.1
# CHURCH_DASHBOARD_PORT=5173
# CHURCH_API_TARGET=http://127.0.0.1:8787

# Planning Center Services + People APIs (single-church Personal Access Token with both permissions)
PLANNING_CENTER_APP_ID=
PLANNING_CENTER_SECRET=

# ProPresenter HTTP API on the production computer
PROPRESENTER_URL=

# Local development defaults. For the Debian production service, override all
# four paths with absolute paths under /var/lib/church-operations (see the
# deployment runbook); the systemd service is sandboxed to that state directory.
VEYRA_DATABASE_PATH=data/church-operations.sqlite
VEYRA_SETUP_KEY_PATH=data/setup-key
VEYRA_PAIRING_SECRET_PATH=data/pairing-secret
VEYRA_MEDIA_DIRECTORY=data/media

# Shure SLX-D read-only monitoring (disabled until one receiver is physically tested)
# Experimental adapter currently assumes an OUTBOUND connection to receiver IPs on TCP 2202.
# The official SLX-D guide describes the receiver as the TCP client; verify direction with one physical unit before enabling.
# Keep disabled until that one-receiver test succeeds. Use DHCP reservations if outbound control is confirmed.
SHURE_SLXD_ENABLED=false
SHURE_SLXD_RECEIVER_IPS=
SHURE_SLXD_PORT=2202
SHURE_SLXD_METER_RATE_MS=1000
