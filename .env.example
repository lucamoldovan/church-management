# Local API
CHURCH_HOST=127.0.0.1
CHURCH_PORT=8787
# For LAN access, configure both TLS files before setting CHURCH_HOST=0.0.0.0
CHURCH_TLS_CERT_PATH=
CHURCH_TLS_KEY_PATH=
CHURCH_DASHBOARD_DIRECTORY=../dashboard/dist

# Planning Center Services + People APIs (single-church Personal Access Token with both permissions)
PLANNING_CENTER_APP_ID=
PLANNING_CENTER_SECRET=

# ProPresenter HTTP API on the production computer
PROPRESENTER_URL=

# Optional storage overrides
VEYRA_DATABASE_PATH=data/church-operations.sqlite
VEYRA_SETUP_KEY_PATH=data/setup-key
VEYRA_PAIRING_SECRET_PATH=data/pairing-secret
VEYRA_MEDIA_DIRECTORY=data/media

# Shure SLX-D third-party controller (disabled until one receiver is physically tested)
# The SLX-D receiver is the TCP client and connects TO this server on port 2202.
# Configure the receiver/controller destination in the receiver network/control settings.
# Use stable DHCP reservations and list only the six receiver IPs below.
SHURE_SLXD_ENABLED=false
SHURE_SLXD_HOST=0.0.0.0
SHURE_SLXD_PORT=2202
SHURE_SLXD_ALLOWED_IPS=
SHURE_SLXD_METER_RATE_MS=1000
