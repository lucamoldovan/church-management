# Casa Pâinii - Church Management Platform
# Copy this file to frontend/.env.local for local development.

# -- Better Auth ------------------------------------------------
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
# APP_BASE_URL can be used by the Worker runtime when NEXT_PUBLIC_APP_URL is not set.
APP_BASE_URL=http://localhost:3000
AUTH_EMAIL_FROM=noreply@casapainii.ro

# -- Bootstrap admin --------------------------------------------
# Optional: the first matching account is created as super_admin.
BOOTSTRAP_ADMIN_EMAIL=

# -- Stripe -----------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# -- Google Calendar / OAuth -----------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary

# -- Facebook Page ----------------------------------------------
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# -- YouTube Live auto-detection -------------------------------
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# -- Planning Center Services ----------------------------------
PLANNING_CENTER_TOKEN=

# -- Misc -------------------------------------------------------
EVENT_TIMEZONE=Europe/Bucharest
